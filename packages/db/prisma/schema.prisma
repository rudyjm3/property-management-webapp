// ─── Disbursement (Advanced Payments & Accounting / Module 4) ────────────────
// A record of an owner disbursement computed from an OwnerStatement's
// distributionAmount, with a configurable management-fee deduction. This is
// a bookkeeping record only — no payout wiring to the owner's bank account
// (Owner Portal doesn't capture owner bank details), so `status` tracks
// whether the manager has recorded the money as sent outside the app.

enum DisbursementStatus {
  pending
  completed
  cancelled
}

model Disbursement {
  id                    String             @id @default(uuid())
  organizationId        String             @map("organization_id")
  ownerStatementId      String             @map("owner_statement_id")
  ownerId               String             @map("owner_id")
  propertyId            String             @map("property_id")
  grossAmount           Decimal            @map("gross_amount") @db.Decimal(12, 2)
  managementFeePct      Decimal            @map("management_fee_pct") @db.Decimal(5, 2)
  managementFeeAmount   Decimal            @map("management_fee_amount") @db.Decimal(12, 2)
  netDisbursementAmount Decimal            @map("net_disbursement_amount") @db.Decimal(12, 2)
  status                DisbursementStatus @default(pending)
  referenceNote         String?            @map("reference_note") @db.VarChar(500)
  disbursedAt           DateTime?          @map("disbursed_at")
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")

  organization   Organization   @relation(fields: [organizationId], references: [id])
  ownerStatement OwnerStatement @relation(fields: [ownerStatementId], references: [id])
  owner          Owner          @relation(fields: [ownerId], references: [id])
  property       Property       @relation(fields: [propertyId], references: [id])

  @@index([organizationId])
  @@index([ownerStatementId])
  @@index([ownerId])
  @@map("disbursements")
}

// ─── Notification ─────────────────────────────────────────────────────────────

model Notification {
  id             String    @id @default(uuid())
  userId         String    @map("user_id")
  organizationId String    @map("organization_id")
  type           String    @db.VarChar(100)
  title          String    @db.VarChar(500)
  body           String
  readAt         DateTime? @map("read_at")
  actionUrl      String?   @map("action_url")
  createdAt      DateTime  @default(now()) @map("created_at")

  user         User         @relation(fields: [userId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([userId, readAt])
  @@map("notifications")
}

// ─── VacancyHistory ───────────────────────────────────────────────────────────
// Point-in-time vacancy snapshot, recorded periodically (e.g. monthly) so
// Reporting & Analytics (Module 11) can chart vacancy-rate history and compare
// it against a manually-entered market rate for the same period.

model VacancyHistory {
  id                   String   @id @default(uuid())
  organizationId       String   @map("organization_id")
  propertyId           String?  @map("property_id")
  snapshotDate         DateTime @map("snapshot_date") @db.Date
  totalUnits           Int      @map("total_units")
  vacantUnits          Int      @map("vacant_units")
  vacancyRatePct       Decimal  @map("vacancy_rate_pct") @db.Decimal(5, 2)
  marketVacancyRatePct Decimal? @map("market_vacancy_rate_pct") @db.Decimal(5, 2)
  createdAt            DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  property     Property?    @relation(fields: [propertyId], references: [id])

  @@unique([organizationId, propertyId, snapshotDate])
  @@index([organizationId, snapshotDate])
  @@map("vacancy_history")
}

// ─── SavedReport ──────────────────────────────────────────────────────────────
// A user-configured report-builder view: which underlying report source to
// pull from, which columns to project, and which filters to apply. Lets
// managers save/reload a custom report instead of re-picking columns each time.

model SavedReport {
  id              String   @id @default(uuid())
  organizationId  String   @map("organization_id")
  createdByUserId String   @map("created_by_user_id")
  name            String   @db.VarChar(200)
  source          String   @db.VarChar(50) // financial-summary | financial-trend | rent-roll | spend-by-location | vacancy-snapshot | vacancy-history
  columns         String[]
  filters         Json
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  createdBy    User         @relation(fields: [createdByUserId], references: [id])

  @@index([organizationId])
  @@map("saved_reports")
}
