// ─── Maintenance Schedule (Grounds & Property Maintenance / Module 3) ─────────
// The net-new piece of Module 3: recurring task scheduling for common-area
// work (landscaping, HVAC filter changes, pest control, etc). A schedule
// generates real WorkOrder records on a cadence — mirrors how
// rentGenerationJob.ts generates monthly Payment records from active leases,
// see groundsMaintenanceJob.ts. Recurrence is a fixed set of cadences
// (weekly/monthly/quarterly/semi_annual/annual), not a full cron-style rule
// engine — see docs/reference/modules.md for what "recurring" does and
// doesn't cover in v1.
model MaintenanceSchedule {
  id              String                 @id @default(uuid())
  organizationId  String                 @map("organization_id")
  propertyId      String                 @map("property_id")
  vendorId        String?                @map("vendor_id")
  title           String                 @db.VarChar(200)
  category        WorkOrderCategory      @default(grounds)
  locationType    WorkOrderLocationType? @map("location_type")
  description     String?
  cadence         MaintenanceCadence
  active          Boolean                @default(true)
  // The next date the recurrence job should generate a WorkOrder for this
  // schedule. Advanced forward by `cadence` each time a WorkOrder is
  // generated (see groundsMaintenanceJob.ts) — never regenerated in the past.
  nextDueDate     DateTime               @map("next_due_date") @db.Date
  lastGeneratedAt DateTime?              @map("last_generated_at")
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  property     Property     @relation(fields: [propertyId], references: [id])
  vendor       Vendor?      @relation(fields: [vendorId], references: [id])
  workOrders   WorkOrder[]

  @@index([organizationId])
  @@index([propertyId])
  @@index([nextDueDate])
  @@map("maintenance_schedules")
}

enum MaintenanceCadence {
  weekly
  monthly
  quarterly
  semi_annual
  annual
}

// ─── Message ──────────────────────────────────────────────────────────────────

model Message {
  id                   String    @id @default(uuid())
  organizationId       String    @map("organization_id")
  threadId             String?   @map("thread_id") @db.VarChar(36)
  unitId               String?   @map("unit_id")
  workOrderId          String?   @map("work_order_id")
  subject              String?   @db.VarChar(500)
  senderUserId         String?   @map("sender_user_id")
  recipientTenantId    String?   @map("recipient_tenant_id")
  body                 String
  attachmentUrl        String?   @map("attachment_url")
  attachmentStorageKey String?   @map("attachment_storage_key") @db.VarChar(1000)
  attachmentName       String?   @map("attachment_name") @db.VarChar(500)
  attachmentMimeType   String?   @map("attachment_mime_type") @db.VarChar(100)
  readAt               DateTime? @map("read_at")
  createdAt            DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  sender       User?        @relation("SentMessages", fields: [senderUserId], references: [id])
  recipient    Tenant?      @relation("ReceivedMessages", fields: [recipientTenantId], references: [id])
  // onDelete: Restrict preserves Module 6's original behavior (a unit with
  // inspections on file can't be deleted) — Prisma's implicit default for an
  // optional relation is SetNull, which would let a unit delete null out
  // unitId on a unit-scoped inspection that has no propertyId either,
  // orphaning it (and its media) from both inspection routes.
  unit         Unit?        @relation(fields: [unitId], references: [id], onDelete: Restrict)
  workOrder    WorkOrder?   @relation(fields: [workOrderId], references: [id])

  @@index([organizationId])
  @@index([recipientTenantId])
  @@index([threadId])
  @@map("messages")
}

