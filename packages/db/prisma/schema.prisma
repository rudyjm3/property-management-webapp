generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Organization ─────────────────────────────────────────────────────────────

model Organization {
  id                            String               @id @default(uuid())
  name                          String               @db.VarChar(200)
  slug                          String               @unique @db.VarChar(200)
  logoUrl                       String?              @map("logo_url")
  email                         String?              @db.VarChar(320)
  phone                         String?              @db.VarChar(20)
  timezone                      String               @default("America/Chicago") @db.VarChar(100)
  dateFormat                    String?              @map("date_format") @db.VarChar(20)
  planTier                      PlanTier             @default(starter) @map("plan_tier")
  stripeCustomerId              String?              @unique @map("stripe_customer_id")
  stripeSubscriptionId          String?              @map("stripe_subscription_id")
  subscriptionStatus            SubscriptionStatus   @default(trialing) @map("subscription_status")
  trialEndsAt                   DateTime?            @map("trial_ends_at")
  stripeAccountId               String?              @unique @map("stripe_account_id")
  stripeAccountStatus           ConnectAccountStatus @default(not_connected) @map("stripe_account_status")
  stripeAccountDetailsSubmitted Boolean              @default(false) @map("stripe_account_details_submitted")
  lateFeeAmount                 Decimal              @default(50) @map("late_fee_amount") @db.Decimal(10, 2)
  gracePeriodDays               Int                  @default(5) @map("grace_period_days")
  rentDueDay                    Int                  @default(1) @map("rent_due_day")
  // Add-on module gating — module keys the org has active (e.g. "owner_portal").
  // No billing wiring yet; see packages/shared/src/constants/modules.ts for the key list.
  activeModules                 String[]             @default([]) @map("active_modules")
  // Advanced Payments & Accounting (Module 4) — org-wide default management-fee
  // percentage deducted from an owner's gross distribution when a Disbursement
  // is created. Overridable per-disbursement; only meaningful once the module
  // is active, but kept ungated on the schema so it's never a breaking migration.
  defaultManagementFeePct       Decimal              @default(10.00) @map("default_management_fee_pct") @db.Decimal(5, 2)
  createdAt                     DateTime             @default(now()) @map("created_at")
  updatedAt                     DateTime             @updatedAt @map("updated_at")

  users                       User[]
  properties                  Property[]
  tenants                     Tenant[]
  vendors                     Vendor[]
  messages                    Message[]
  documents                   Document[]
  notifications               Notification[]
  ledgerEntries               LedgerEntry[]
  rentalApplications          RentalApplication[]
  owners                      Owner[]
  ownerStatements             OwnerStatement[]
  vacancyHistory              VacancyHistory[]
  savedReports                SavedReport[]
  screeningChecks             ScreeningCheck[]
  disbursements               Disbursement[]
  securityDepositDispositions SecurityDepositDisposition[]
  inspections                 Inspection[]
  inspectionTemplates         InspectionTemplate[]
  maintenanceSchedules        MaintenanceSchedule[]

  @@map("organizations")
}

enum PlanTier {
  starter
  pro
  enterprise
}

enum SubscriptionStatus {
  active
  trialing
  past_due
  canceled
}

enum ConnectAccountStatus {
  not_connected
  pending
  active
  restricted
}

// ─── User ─────────────────────────────────────────────────────────────────────

model User {
  id               String     @id @default(uuid())
  organizationId   String     @map("organization_id")
  supabaseUserId   String?    @unique @map("supabase_user_id")
  email            String     @db.VarChar(320)
  name             String     @db.VarChar(200)
  phone            String?    @db.VarChar(20)
  role             UserRole   @default(manager)
  status           UserStatus @default(active)
  avatarUrl        String?    @map("avatar_url")
  invitedAt        DateTime?  @map("invited_at")
  lastLoginAt      DateTime?  @map("last_login_at")
  notifRentOverdue String?    @map("notif_rent_overdue") @db.VarChar(20)
  notifWorkOrder   String?    @map("notif_work_order") @db.VarChar(20)
  notifLeaseExpiry String?    @map("notif_lease_expiry") @db.VarChar(20)
  notifNewMessage  String?    @map("notif_new_message") @db.VarChar(20)
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  organization        Organization   @relation(fields: [organizationId], references: [id])
  assignedOrders      WorkOrder[]    @relation("AssignedWorkOrders")
  submittedOrders     WorkOrder[]    @relation("SubmittedWorkOrders")
  sentMessages        Message[]      @relation("SentMessages")
  uploadedDocuments   Document[]     @relation("UploadedDocuments")
  notifications       Notification[]
  savedReports        SavedReport[]
  inspectionsAssigned Inspection[]   @relation("InspectionInspector")

  @@unique([organizationId, email])
  @@index([organizationId])
  @@map("users")
}

enum UserRole {
  owner
  manager
  maintenance
}

enum UserStatus {
  active
  invited
  deactivated
}

// ─── Property ─────────────────────────────────────────────────────────────────

model Property {
  id                    String       @id @default(uuid())
  organizationId        String       @map("organization_id")
  name                  String       @db.VarChar(200)
  type                  PropertyType @default(multifamily)
  address               String       @db.VarChar(500)
  city                  String       @db.VarChar(100)
  state                 String       @db.Char(2)
  zip                   String       @db.VarChar(10)
  country               String       @default("US") @db.VarChar(2)
  jurisdictionNotes     String?      @map("jurisdiction_notes")
  yearBuilt             Int?         @map("year_built")
  unitCount             Int          @default(0) @map("unit_count")
  amenities             String[]
  photoUrl              String?      @map("photo_url")
  notes                 String?
  taxParcelId           String?      @map("tax_parcel_id") @db.VarChar(100)
  insurancePolicyNumber String?      @map("insurance_policy_number") @db.VarChar(200)
  insuranceExpiresAt    DateTime?    @map("insurance_expires_at") @db.Date
  createdAt             DateTime     @default(now()) @map("created_at")
  updatedAt             DateTime     @updatedAt @map("updated_at")

  organization         Organization          @relation(fields: [organizationId], references: [id])
  units                Unit[]
  workOrders           WorkOrder[]
  propertyOwners       PropertyOwner[]
  ownerStatements      OwnerStatement[]
  disbursements        Disbursement[]
  vacancyHistory       VacancyHistory[]
  // Grounds & Property Maintenance (Module 3) — common-area/grounds inspections
  // (Inspection.propertyId) and recurring maintenance schedules both live at
  // the property level, not the unit level.
  inspections          Inspection[]
  maintenanceSchedules MaintenanceSchedule[]

  @@index([organizationId])
  @@map("properties")
}

enum PropertyType {
  multifamily
  single_family
  commercial
  mixed_use
  // Legacy values — kept for backward compat with seed data
  apartment
  condo
  house
}

// ─── Unit ─────────────────────────────────────────────────────────────────────

model Unit {
  id                   String     @id @default(uuid())
  propertyId           String     @map("property_id")
  unitNumber           String     @map("unit_number") @db.VarChar(20)
  floor                Int?
  type                 UnitType?
  bedrooms             Int        @default(1)
  bathrooms            Float      @default(1)
  sqFt                 Int?       @map("sq_ft")
  marketRent           Decimal?   @map("market_rent") @db.Decimal(10, 2)
  rentAmount           Decimal    @map("rent_amount") @db.Decimal(10, 2)
  depositAmount        Decimal    @default(0) @map("deposit_amount") @db.Decimal(10, 2)
  status               UnitStatus @default(vacant)
  availableDate        DateTime?  @map("available_date") @db.Date
  parkingSpaces        String[]   @map("parking_spaces")
  storageUnit          String?    @map("storage_unit") @db.VarChar(100)
  utilityMeterElectric String?    @map("utility_meter_electric") @db.VarChar(100)
  utilityMeterGas      String?    @map("utility_meter_gas") @db.VarChar(100)
  utilityMeterWater    String?    @map("utility_meter_water") @db.VarChar(100)
  address              String?    @db.VarChar(500)
  city                 String?    @db.VarChar(100)
  state                String?    @db.Char(2)
  zip                  String?    @db.VarChar(10)
  notes                String?
  lastInspectionAt     DateTime?  @map("last_inspection_at")
  lastRenovationAt     DateTime?  @map("last_renovation_at") @db.Date
  applianceCount       Int?       @map("appliance_count")
  createdAt            DateTime   @default(now()) @map("created_at")
  updatedAt            DateTime   @updatedAt @map("updated_at")

  property           Property            @relation(fields: [propertyId], references: [id])
  leases             Lease[]
  workOrders         WorkOrder[]
  messages           Message[]
  rentalApplications RentalApplication[]
  appliances         Appliance[]
  inspections        Inspection[]

  @@unique([propertyId, unitNumber])
  @@index([propertyId])
  @@index([status])
  @@map("units")
}

enum UnitType {
  studio
  one_bed
  two_bed
  three_bed
  four_plus_bed
  commercial
}

enum UnitStatus {
  vacant
  occupied
  notice
  maintenance
  unlisted
}

// ─── Appliance (Unit Intelligence & Appliance Registry) ────────────────────────

model Appliance {
  id                  String            @id @default(uuid())
  unitId              String            @map("unit_id")
  category            ApplianceCategory @default(other)
  status              ApplianceStatus   @default(active)
  make                String?           @db.VarChar(100)
  model               String?           @db.VarChar(100)
  serialNumber        String?           @map("serial_number") @db.VarChar(100)
  purchaseDate        DateTime?         @map("purchase_date") @db.Date
  installDate         DateTime?         @map("install_date") @db.Date
  warrantyExpiresAt   DateTime?         @map("warranty_expires_at") @db.Date
  removedAt           DateTime?         @map("removed_at") @db.Date
  // The prior appliance this one replaced in the same physical slot (e.g. the
  // old dishwasher a new one was swapped in for) — forms a one-to-one
  // replacement chain. Null if this appliance wasn't installed as a
  // replacement. @unique enforces that an old appliance can be pointed to by
  // at most one replacement.
  replacesApplianceId String?           @unique @map("replaces_appliance_id")
  notes               String?
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")

  unit              Unit        @relation(fields: [unitId], references: [id], onDelete: Cascade)
  workOrders        WorkOrder[]
  replacesAppliance Appliance?  @relation("ApplianceReplacement", fields: [replacesApplianceId], references: [id], onDelete: SetNull)
  replacedBy        Appliance?  @relation("ApplianceReplacement")

  @@index([unitId])
  @@index([unitId, status])
  @@map("appliances")
}

enum ApplianceStatus {
  active
  removed
}

// End-of-life threshold, in years, used to compute a replacement alert off
// installDate (falling back to purchaseDate) — see appliance.service.ts.
enum ApplianceCategory {
  hvac
  water_heater
  refrigerator
  dishwasher
  washer
  dryer
  oven_range
  microwave
  garbage_disposal
  other
}

// ─── Inspection & Compliance (Module 6) ────────────────────────────────────────
// Configurable move-in/move-out inspection templates, scheduled inspection
// workflows, photo/video documentation, and signature capture. See
// docs/reference/modules.md "Module 6" for exactly what's built vs. simplified
// for v1 (template configurability level, signature mechanism, GPS caveats).

// InspectionTemplate.checklistItems is an array of
// { section: string, item: string, description?: string } objects — real
// per-organization stored data (CRUD via inspection-template.service.ts), but
// v1 ships with a single seeded default template rather than a full
// property-type-aware template picker.
model InspectionTemplate {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String   @db.VarChar(200)
  description    String?
  checklistItems Json     @map("checklist_items")
  isDefault      Boolean  @default(false) @map("is_default")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  inspections  Inspection[]

  @@index([organizationId])
  @@map("inspection_templates")
}

// Signature capture uses the same shape as the lease e-signature flow
// (lease-esignature.service.ts): a typed attestation name + capture IP +
// timestamp, not a canvas-drawn image — see modules.md for why. Both
// tenant and manager signatures are captured on the same completion request,
// i.e. a manager/inspector-device walkthrough rather than a separate
// tenant-facing public signing link.
// As of Module 3 (Grounds & Property Maintenance), an Inspection is either
// unit-scoped (unitId set, propertyId null — Module 6's original move-in/
// move-out/scheduled/annual/semi-annual inspections) or property-scoped
// (propertyId set, unitId null — a common-area/grounds inspection of type
// `grounds`, created via .../properties/:propertyId/inspections). Exactly
// one of the two must be set; enforced in inspection.service.ts, not by a
// DB constraint, matching this codebase's existing app-level validation
// style. leaseId only ever applies to unit-scoped inspections.
model Inspection {
  id                   String           @id @default(uuid())
  organizationId       String           @map("organization_id")
  unitId               String?          @map("unit_id")
  propertyId           String?          @map("property_id")
  leaseId              String?          @map("lease_id")
  type                 InspectionType
  status               InspectionStatus @default(scheduled)
  scheduledAt          DateTime?        @map("scheduled_at")
  completedAt          DateTime?        @map("completed_at")
  inspectorUserId      String?          @map("inspector_user_id")
  templateId           String?          @map("template_id")
  checklistResults     Json             @default("[]") @map("checklist_results")
  notes                String?
  tenantSignatureName  String?          @map("tenant_signature_name") @db.VarChar(200)
  tenantSignatureAt    DateTime?        @map("tenant_signature_at")
  tenantSignatureIp    String?          @map("tenant_signature_ip") @db.VarChar(45)
  managerSignatureName String?          @map("manager_signature_name") @db.VarChar(200)
  managerSignatureAt   DateTime?        @map("manager_signature_at")
  managerSignatureIp   String?          @map("manager_signature_ip") @db.VarChar(45)
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")

  organization      Organization                 @relation(fields: [organizationId], references: [id])
  unit              Unit?                        @relation(fields: [unitId], references: [id])
  property          Property?                    @relation(fields: [propertyId], references: [id])
  lease             Lease?                       @relation(fields: [leaseId], references: [id])
  inspector         User?                        @relation("InspectionInspector", fields: [inspectorUserId], references: [id])
  template          InspectionTemplate?          @relation(fields: [templateId], references: [id])
  media             InspectionMedia[]
  depositsAsMoveIn  SecurityDepositDisposition[] @relation("DepositMoveInInspection")
  depositsAsMoveOut SecurityDepositDisposition[] @relation("DepositMoveOutInspection")

  @@index([organizationId])
  @@index([unitId])
  @@index([propertyId])
  @@index([leaseId])
  @@index([status])
  @@map("inspections")
}

enum InspectionType {
  move_in
  move_out
  scheduled
  annual
  semi_annual
  // Property-scoped common-area/grounds inspection — Module 3 (Grounds &
  // Property Maintenance). Always paired with propertyId set, unitId null.
  grounds
}

enum InspectionStatus {
  scheduled
  in_progress
  completed
  cancelled
}

// Photo/video documentation attached to an inspection. Follows the same
// presigned-upload pattern as Document/WorkOrder photos (storage.service.ts):
// the client requests an upload URL scoped to the inspection, uploads
// directly to Supabase Storage, then records the resulting key here.
// capturedAt always has a value (client-supplied or server now() fallback);
// latitude/longitude are best-effort — populated only when the browser grants
// Geolocation permission, and unverified beyond the code path since this was
// built in a non-mobile session (see modules.md).
model InspectionMedia {
  id           String              @id @default(uuid())
  inspectionId String              @map("inspection_id")
  storageKey   String              @map("storage_key")
  mediaType    InspectionMediaType @map("media_type")
  capturedAt   DateTime            @map("captured_at")
  latitude     Decimal?            @db.Decimal(9, 6)
  longitude    Decimal?            @db.Decimal(9, 6)
  createdAt    DateTime            @default(now()) @map("created_at")

  inspection Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@index([inspectionId])
  @@map("inspection_media")
}

enum InspectionMediaType {
  photo
  video
}

// ─── Tenant ───────────────────────────────────────────────────────────────────

model Tenant {
  id                            String            @id @default(uuid())
  organizationId                String            @map("organization_id")
  supabaseUserId                String?           @unique @map("supabase_user_id")
  // Identity
  email                         String            @db.VarChar(320)
  name                          String            @db.VarChar(200)
  fullLegalName                 String?           @map("full_legal_name") @db.VarChar(200)
  preferredName                 String?           @map("preferred_name") @db.VarChar(200)
  dateOfBirth                   DateTime?         @map("date_of_birth") @db.Date
  phone                         String?           @db.VarChar(20)
  phoneSecondary                String?           @map("phone_secondary") @db.VarChar(20)
  preferredContact              PreferredContact? @map("preferred_contact")
  languagePreference            String?           @map("language_preference") @db.VarChar(10)
  avatarUrl                     String?           @map("avatar_url")
  // Screening — module-flagged, all nullable; populate when Screening module ships
  ssnLast4                      String?           @map("ssn_last4") @db.Char(4)
  ssnFullEncrypted              String?           @map("ssn_full_encrypted")
  govtIdType                    GovernmentIdType? @map("govt_id_type")
  govtIdNumber                  String?           @map("govt_id_number")
  screeningConsentAt            DateTime?         @map("screening_consent_at")
  // Address history
  currentAddress                String?           @map("current_address") @db.VarChar(500)
  previousAddress               String?           @map("previous_address") @db.VarChar(500)
  // Employment & income
  employerName                  String?           @map("employer_name") @db.VarChar(200)
  employerPhone                 String?           @map("employer_phone") @db.VarChar(20)
  monthlyGrossIncome            Decimal?          @map("monthly_gross_income") @db.Decimal(10, 2)
  incomeSource                  IncomeSource?     @map("income_source")
  // Emergency contacts
  emergencyContactName          String?           @map("emergency_contact_name") @db.VarChar(200)
  emergencyContactPhone         String?           @map("emergency_contact_phone") @db.VarChar(20)
  emergencyContact1Relationship String?           @map("emergency_contact_1_relationship") @db.VarChar(100)
  emergencyContact1Email        String?           @map("emergency_contact_1_email") @db.VarChar(320)
  emergencyContact2Name         String?           @map("emergency_contact_2_name") @db.VarChar(200)
  emergencyContact2Phone        String?           @map("emergency_contact_2_phone") @db.VarChar(20)
  emergencyContact2Relationship String?           @map("emergency_contact_2_relationship") @db.VarChar(100)
  // Vehicles & pets (JSONB)
  vehicles                      Json?
  pets                          Json?
  // Portal
  portalStatus                  PortalStatus      @default(never_logged_in) @map("portal_status")
  portalInvitedAt               DateTime?         @map("portal_invited_at")
  notifPaymentConfirm           String?           @map("notif_payment_confirm") @db.VarChar(20)
  notifWorkOrderUpdate          String?           @map("notif_work_order_update") @db.VarChar(20)
  notifMessage                  String?           @map("notif_message") @db.VarChar(20)
  expoPushToken                 String?           @map("expo_push_token") @db.VarChar(200)
  // Invite-code activation (mobile onboarding)
  inviteCode                    String?           @unique @map("invite_code") @db.Char(8)
  inviteCodeExpiresAt           DateTime?         @map("invite_code_expires_at")
  // Autopay
  autopayEnabled                Boolean           @default(false) @map("autopay_enabled")
  stripeCustomerId              String?           @unique @map("stripe_customer_id")
  stripeDefaultPaymentMethodId  String?           @map("stripe_default_payment_method_id")
  createdAt                     DateTime          @default(now()) @map("created_at")
  updatedAt                     DateTime          @updatedAt @map("updated_at")
  deletedAt                     DateTime?         @map("deleted_at")

  organization      Organization       @relation(fields: [organizationId], references: [id])
  leaseParticipants LeaseParticipant[]
  payments          Payment[]
  workOrders        WorkOrder[]
  receivedMessages  Message[]          @relation("ReceivedMessages")

  @@unique([organizationId, email])
  @@index([organizationId])
  @@map("tenants")
}

// ─── Rental Application ───────────────────────────────────────────────────────

model RentalApplication {
  id                    String                  @id @default(uuid())
  organizationId        String                  @map("organization_id")
  unitId                String                  @map("unit_id")
  token                 String                  @unique @db.VarChar(36)
  status                RentalApplicationStatus @default(pending)
  // Applicant info
  applicantName         String                  @map("applicant_name") @db.VarChar(200)
  applicantEmail        String                  @map("applicant_email") @db.VarChar(320)
  applicantPhone        String?                 @map("applicant_phone") @db.VarChar(20)
  dateOfBirth           DateTime?               @map("date_of_birth") @db.Date
  currentAddress        String?                 @map("current_address") @db.VarChar(500)
  previousAddress       String?                 @map("previous_address") @db.VarChar(500)
  // Employment
  employerName          String?                 @map("employer_name") @db.VarChar(200)
  employerPhone         String?                 @map("employer_phone") @db.VarChar(20)
  monthlyGrossIncome    Decimal?                @map("monthly_gross_income") @db.Decimal(10, 2)
  incomeSource          IncomeSource?           @map("income_source")
  // Household
  occupantCount         Int                     @default(1) @map("occupant_count")
  pets                  Json?
  vehicles              Json?
  // Emergency contact
  emergencyContactName  String?                 @map("emergency_contact_name") @db.VarChar(200)
  emergencyContactPhone String?                 @map("emergency_contact_phone") @db.VarChar(20)
  // Consent
  consentGiven          Boolean                 @default(false) @map("consent_given")
  consentIp             String?                 @map("consent_ip") @db.VarChar(45)
  consentAt             DateTime?               @map("consent_at")
  // Screening — Advanced Tenant Onboarding module (gated); captured here
  // before a Tenant record exists, then copied onto Tenant's own dormant
  // screening fields when the application is approved. ssnFullEncrypted and
  // govtIdNumber are ciphertext at rest (see encryption.service.ts) — never
  // plaintext, never logged.
  screeningConsentAt    DateTime?               @map("screening_consent_at")
  screeningConsentIp    String?                 @map("screening_consent_ip") @db.VarChar(45)
  ssnFullEncrypted      String?                 @map("ssn_full_encrypted")
  govtIdType            GovernmentIdType?       @map("govt_id_type")
  govtIdNumber          String?                 @map("govt_id_number")
  // Review
  reviewNotes           String?                 @map("review_notes")
  reviewedAt            DateTime?               @map("reviewed_at")
  reviewedByUserId      String?                 @map("reviewed_by_user_id")
  createdTenantId       String?                 @map("created_tenant_id")
  submittedAt           DateTime?               @map("submitted_at")
  createdAt             DateTime                @default(now()) @map("created_at")
  updatedAt             DateTime                @updatedAt @map("updated_at")

  organization    Organization     @relation(fields: [organizationId], references: [id])
  unit            Unit             @relation(fields: [unitId], references: [id])
  screeningChecks ScreeningCheck[]

  @@index([organizationId])
  @@index([unitId])
  @@index([token])
  @@map("rental_applications")
}

// ─── Screening (Advanced Tenant Onboarding module) ────────────────────────────
// Background/credit check runs against a RentalApplication, gated behind
// `advanced_tenant_onboarding` in Organization.activeModules. The provider
// call itself is abstracted behind ScreeningProviderClient
// (screening-provider.client.ts) — as of this writing that client is a mock
// pending real TransUnion SmartMove API credentials. Never store raw
// SSN/govt ID here; those live only as ciphertext on RentalApplication/Tenant.
model ScreeningCheck {
  id                  String             @id @default(uuid())
  organizationId      String             @map("organization_id")
  rentalApplicationId String             @map("rental_application_id")
  provider            ScreeningProvider  @default(transunion_smartmove)
  status              ScreeningStatus    @default(pending)
  decision            ScreeningDecision?
  providerReferenceId String?            @map("provider_reference_id")
  reportUrl           String?            @map("report_url")
  errorMessage        String?            @map("error_message")
  requestedByUserId   String             @map("requested_by_user_id")
  requestedAt         DateTime           @default(now()) @map("requested_at")
  completedAt         DateTime?          @map("completed_at")
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")

  organization      Organization      @relation(fields: [organizationId], references: [id])
  rentalApplication RentalApplication @relation(fields: [rentalApplicationId], references: [id])

  @@index([organizationId])
  @@index([rentalApplicationId])
  @@map("screening_checks")
}

enum ScreeningProvider {
  transunion_smartmove
}

enum ScreeningStatus {
  pending
  in_progress
  completed
  failed
}

enum ScreeningDecision {
  recommend
  caution
