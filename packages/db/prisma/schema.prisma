// ─── Lease ────────────────────────────────────────────────────────────────────

model Lease {
  id                          String                @id @default(uuid())
  unitId                      String                @map("unit_id")
  // Status & type
  status                      LeaseStatus           @default(active)
  type                        LeaseType?
  // Dates & terms
  startDate                   DateTime              @map("start_date") @db.Date
  endDate                     DateTime              @map("end_date") @db.Date
  moveInDate                  DateTime?             @map("move_in_date") @db.Date
  moveOutDate                 DateTime?             @map("move_out_date") @db.Date
  noticePeriodDays            Int                   @default(30) @map("notice_period_days")
  rentAmount                  Decimal               @map("rent_amount") @db.Decimal(10, 2)
  rentDueDay                  Int                   @default(1) @map("rent_due_day")
  lateFeeAmount               Decimal               @default(0) @map("late_fee_amount") @db.Decimal(10, 2)
  lateFeeGraceDays            Int                   @default(5) @map("late_fee_grace_days")
  // Security deposit
  depositAmount               Decimal               @default(0) @map("deposit_amount") @db.Decimal(10, 2)
  securityDepositPaidAt       DateTime?             @map("security_deposit_paid_at") @db.Date
  securityDepositStatus       SecurityDepositStatus @default(held) @map("security_deposit_status")
  securityDepositReturnedAt   DateTime?             @map("security_deposit_returned_at") @db.Date
  securityDepositReturnAmount Decimal?              @map("security_deposit_return_amount") @db.Decimal(10, 2)
  securityDepositDeductions   Json?                 @map("security_deposit_deductions")
  // Utilities & addenda
  utilitiesIncluded           String[]              @map("utilities_included")
  hasPetAddendum              Boolean               @default(false) @map("has_pet_addendum")
  petDepositAmount            Decimal?              @map("pet_deposit_amount") @db.Decimal(10, 2)
  hasParkingAddendum          Boolean               @default(false) @map("has_parking_addendum")
  parkingFee                  Decimal?              @map("parking_fee") @db.Decimal(10, 2)
  // Occupancy
  occupantCount               Int                   @default(1) @map("occupant_count")
  occupantNames               String[]              @map("occupant_names")
  // Documents & signing
  documentUrl                 String?               @map("document_url")
  esignatureStatus            EsignatureStatus      @default(pending) @map("esignature_status")
  tenantSignedAt              DateTime?             @map("tenant_signed_at")
  managerSignedAt             DateTime?             @map("manager_signed_at")
  signingToken                String?               @unique @map("signing_token") @db.VarChar(36)
  tenantSignatureName         String?               @map("tenant_signature_name") @db.VarChar(200)
  managerSignatureName        String?               @map("manager_signature_name") @db.VarChar(200)
  tenantSignatureIp           String?               @map("tenant_signature_ip") @db.VarChar(45)
  managerSignatureIp          String?               @map("manager_signature_ip") @db.VarChar(45)
  renewalOfLeaseId            String?               @map("renewal_of_lease_id")
  notes                       String?
  createdAt                   DateTime              @default(now()) @map("created_at")
  updatedAt                   DateTime              @updatedAt @map("updated_at")
  deletedAt                   DateTime?             @map("deleted_at")

  unit                       Unit                        @relation(fields: [unitId], references: [id])
  renewalOf                  Lease?                      @relation("LeaseRenewals", fields: [renewalOfLeaseId], references: [id])
  renewals                   Lease[]                     @relation("LeaseRenewals")
  participants               LeaseParticipant[]
  payments                   Payment[]
  securityDepositDisposition SecurityDepositDisposition?
  inspections                Inspection[]

  @@index([unitId])
  @@index([status])
  @@index([endDate])
  @@map("leases")
}

// ─── SecurityDepositDisposition (Advanced Payments & Accounting / Module 4) ───
// Formalizes the deposit-vs-deductions math the move-out workflow already
// computes onto `Lease.securityDeposit*` into a persisted, auditable
// disposition record. Reconciles against the itemized deductions captured at
// move-out. As of Module 6 (Inspections & Compliance), when the lease has a
// completed move-in and/or move-out Inspection on file, reconcileSecurityDeposit
// (lease.service.ts) links them via moveInInspectionId/moveOutInspectionId
// below and prefers their checklist data; the moveIn/moveOutConditionNotes
// free-text fields remain for backward compatibility and for leases with no
// inspection on file.

model SecurityDepositDisposition {
  id                    String                @id @default(uuid())
  organizationId        String                @map("organization_id")
  leaseId               String                @unique @map("lease_id")
  depositAmount         Decimal               @map("deposit_amount") @db.Decimal(10, 2)
  totalDeductions       Decimal               @map("total_deductions") @db.Decimal(10, 2)
  returnAmount          Decimal               @map("return_amount") @db.Decimal(10, 2)
  status                SecurityDepositStatus
  deductions            Json
  moveInConditionNotes  String?               @map("move_in_condition_notes")
  moveOutConditionNotes String?               @map("move_out_condition_notes")
  moveInInspectionId    String?               @map("move_in_inspection_id")
  moveOutInspectionId   String?               @map("move_out_inspection_id")
  reconciledByUserId    String                @map("reconciled_by_user_id")
  reconciledAt          DateTime              @default(now()) @map("reconciled_at")
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")

  organization      Organization @relation(fields: [organizationId], references: [id])
  lease             Lease        @relation(fields: [leaseId], references: [id])
  moveInInspection  Inspection?  @relation("DepositMoveInInspection", fields: [moveInInspectionId], references: [id], onDelete: SetNull)
  moveOutInspection Inspection?  @relation("DepositMoveOutInspection", fields: [moveOutInspectionId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([moveInInspectionId])
  @@index([moveOutInspectionId])
  @@map("security_deposit_dispositions")
}

