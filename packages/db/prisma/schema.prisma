// ─── Payment ──────────────────────────────────────────────────────────────────

model Payment {
  id                    String        @id @default(uuid())
  leaseId               String        @map("lease_id")
  tenantId              String        @map("tenant_id")
  amount                Decimal       @db.Decimal(10, 2)
  type                  PaymentType   @default(rent)
  status                PaymentStatus @default(pending)
  method                PaymentMethod @default(other)
  stripePaymentIntentId String?       @map("stripe_payment_intent_id")
  checkNumber           String?       @map("check_number") @db.VarChar(50)
  referenceNote         String?       @map("reference_note") @db.VarChar(500)
  paidAt                DateTime?     @map("paid_at")
  voidedAt              DateTime?     @map("voided_at")
  voidReason            String?       @map("void_reason") @db.VarChar(500)
  dueDate               DateTime      @map("due_date") @db.Date
  periodStart           DateTime?     @map("period_start") @db.Date
  periodEnd             DateTime?     @map("period_end") @db.Date
  isLate                Boolean       @default(false) @map("is_late")
  lateFeeApplied        Boolean       @default(false) @map("late_fee_applied")
  lateFeeWaived         Boolean?      @map("late_fee_waived")
  lateFeeWaivedReason   String?       @map("late_fee_waived_reason") @db.VarChar(500)
  notes                 String?
  // Partial payment handling (Advanced Payments & Accounting / Module 4).
  // originalAmount preserves the amount that was actually due before a
  // partial payment reduced `amount` down to what was actually received.
  // carriedFromPaymentId points a carry-forward payment (the remaining
  // balance) back at the original payment it was split from.
  originalAmount        Decimal?      @map("original_amount") @db.Decimal(10, 2)
  carriedFromPaymentId  String?       @map("carried_from_payment_id")
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")
  deletedAt             DateTime?     @map("deleted_at")

  lease                  Lease         @relation(fields: [leaseId], references: [id])
  tenant                 Tenant        @relation(fields: [tenantId], references: [id])
  ledgerEntries          LedgerEntry[]
  carriedFromPayment     Payment?      @relation("PaymentCarryForward", fields: [carriedFromPaymentId], references: [id])
  carriedForwardPayments Payment[]     @relation("PaymentCarryForward")

  @@index([leaseId])
  @@index([tenantId])
  @@index([status])
  @@index([dueDate])
  @@map("payments")
}

enum PaymentType {
